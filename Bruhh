                board.Text = board.Text .. " -> " .. m.winner.code
            end
            board.Text = board.Text .. "\n"
            if i >= 8 then break end
        end
    end
    board.Parent = gui
    
    task.delay(5, function() if gui then gui:Destroy() end end)
end

