local function updatePlayerAppearance()
    local char=gameState.playerChar
    if not char then return end
    local newColor=(gameState.playerTeam=="Red") and Color3.fromRGB(255,50,50) or Color3.fromRGB(50,50,255)
    for _,part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and (part.Name=="Torso" or part.Name:find("Arm")) then
            part.Color=newColor
        elseif part:IsA("Shirt") or part:IsA("Pants") then
            part:Destroy()
        end
    end
end

local function playBallKick(position, pitch)
    local p=Instance.new("Part")
    p.Anchored=true; p.CanCollide=false; p.Transparency=1
    p.Size=Vector3.new(1,1,1); p.Position=position; p.Parent=workspace
    local s=Instance.new("Sound")
    s.SoundId=BALLKICK_SOUND; s.Volume=0.6; s.Pitch=pitch or 1
    s.RollOffMaxDistance=500; s.RollOffMinDistance=20
    s.Parent=p; s:Play()
    task.delay(5, function() if p then p:Destroy() end end)
end

local function moveCharacter(bot, newTorsoPos, lookTarget)
    local dir = lookTarget - newTorsoPos
    local horizDir = Vector3.new(dir.X, 0, dir.Z)
    if horizDir.Magnitude < 0.1 then horizDir = Vector3.new(0, 0, 1) end
    horizDir = horizDir.Unit
    local yaw = math.atan2(-horizDir.X, -horizDir.Z)
    local baseCFrame = CFrame.new(newTorsoPos) * CFrame.Angles(0, yaw, 0)
    for _,part in ipairs(bot:GetChildren()) do
        if part:IsA("BasePart") then
            local ox = part:GetAttribute("OffX") or 0
            local oy = part:GetAttribute("OffY") or 0
            local oz = part:GetAttribute("OffZ") or 0
            part.CFrame = baseCFrame * CFrame.new(ox, oy, oz)
        end
    end
end

local function setupFieldLighting()
    Lighting.Brightness = 3
