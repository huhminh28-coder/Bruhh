local function playerTakePenalty(shootBtn)
    shootBtn.Enabled = false
    local ball = gameState.ball
    if not ball then return end
    
    -- Random chance based on random direction
    local targetX = MAP_POS.X + math.random(-25, 25)
    local targetY = MAP_POS.Y + math.random(8, 22)
    local goalZ = MAP_POS.Z + PITCH_LENGTH/2
    local targetPos = Vector3.new(targetX, targetY, goalZ)
    local direction = (targetPos - ball.Position).Unit
    local power = math.random(200, 300)
    local spinAmount = math.random(-100, 100)
    
    ball.AssemblyLinearVelocity = direction * power + Vector3.new(0, 25, 0)
    playBallKick(ball.Position, math.random(85, 110)/100)
    
    -- Apply spin
    if spinAmount > 0 then
        local startTime = tick()
        local spinRate = spinAmount/800
        local conn
        conn = RunService.Heartbeat:Connect(function(dt)
            if not ball or not ball.Parent or tick()-startTime > 1.5 then
                if conn then conn:Disconnect() end
                return
            end
            local t = (tick()-startTime)/1.5
            local angle = spinRate * (1-t) * dt
            local v = ball.AssemblyLinearVelocity
            if v.Magnitude > 5 then
                local c,s = math.cos(angle), math.sin(angle)
                ball.AssemblyLinearVelocity = Vector3.new(v.X*c-v.Z*s, v.Y, v.X*s+v.Z*c)
            end
        end)
    end
    
    -- AI goalkeeper tries to save
    local gk = nil
    for _,bot in ipairs(gameState.blueTeam) do
        if bot.Role.Value == "Goalkeeper" then gk = bot end
    end
    if gk then
        -- Predict where ball will go
        task.wait(0.15)
        local ballPos = ball.Position
        local ballVel = ball.AssemblyLinearVelocity
        if math.abs(ballVel.Z) > 5 then
            local timeToGoal = (goalZ - ballPos.Z) / ballVel.Z
            if timeToGoal > 0 then
                local predX = ballPos.X + ballVel.X * timeToGoal
                local predY = ballPos.Y + ballVel.Y * timeToGoal - 0.5 * workspace.Gravity * timeToGoal * timeToGoal
                if gk.PrimaryPart then
                    local targetX2 = math.clamp(predX, MAP_POS.X - GOAL_WIDTH/2 + 3, MAP_POS.X + GOAL_WIDTH/2 - 3)
                    local jumpH = 0
                    if predY > MAP_POS.Y + 12 then jumpH = math.clamp(predY - MAP_POS.Y - 8, 0, 22) end
                    moveCharacter(gk, Vector3.new(targetX2, TORSO_Y + jumpH, MAP_POS.Z + PITCH_LENGTH/2 - 5), Vector3.new(predX, TORSO_Y, ballPos.Z))
                end
            end
        end
    end
    
    task.wait(1)
    -- Check if goal scored
    local scored = false
    if ball.Position.Z > goalZ - 5 then
        if math.abs(ball.Position.X - MAP_POS.X) < GOAL_WIDTH/2 - 2 
           and ball.Position.Y - MAP_POS.Y < GOAL_HEIGHT - 2 
           and ball.Position.Y - MAP_POS.Y > 0 then
            scored = true
        end
    end
    
    -- Check if GK saved
    if gk and gk.PrimaryPart then
        if (gk.PrimaryPart.Position - ball.Position).Magnitude < 8 then
            scored = false
        end
    end
    
    if scored then
        penaltyState.playerScore = penaltyState.playerScore + 1
    end
    updatePenaltyScore()
    
    task.wait(1)
    shootBtn.Enabled = true
end

