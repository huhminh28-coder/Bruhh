local function startFieldMatch(teamA, teamB, playerTeamName, callback)
    -- Determine which is Red (player) and Blue (opponent)
    local redName, blueName
    if playerTeamName == teamA then
        redName = teamA; blueName = teamB
    else
        redName = teamB; blueName = teamA
    end
    
    gameState.redTeamName = redName
    gameState.blueTeamName = blueName
    gameState.scoreRed = 0
    gameState.scoreBlue = 0
    gameState.timeLeft = HALF_TIME
    gameState.currentHalf = 1
    gameState.isExtraTime = false
    gameState.gameActive = true
    gameState.paused = false
    gameState.goalScored = false
    gameState.playerDribbling = false
    gameState.sprinting = false
    gameState.matchEndCallback = callback
    
    tournament.fieldActive = true
    tournament.matchInProgress = true
    
    local char = player.Character or player.CharacterAdded:Wait()
    gameState.playerChar = char
    
    setupFieldLighting()
    createStadium()
    createBall()
    
    createAIPlayer("Red","Goalkeeper",1)
    createAIPlayer("Red","Defender",1)
    createAIPlayer("Red","Defender",2)
    createAIPlayer("Red","Defender",3)
    createAIPlayer("Red","Defender",4)
    createAIPlayer("Red","Midfielder",1)
    createAIPlayer("Red","Midfielder",2)
    createAIPlayer("Red","Midfielder",3)
    createAIPlayer("Red","Midfielder",4)
    createAIPlayer("Red","Striker",1)
    createAIPlayer("Red","Striker",2)
    createAIPlayer("Blue","Goalkeeper",1)
    createAIPlayer("Blue","Defender",1)
    createAIPlayer("Blue","Defender",2)
    createAIPlayer("Blue","Defender",3)
    createAIPlayer("Blue","Defender",4)
    createAIPlayer("Blue","Midfielder",1)
    createAIPlayer("Blue","Midfielder",2)
    createAIPlayer("Blue","Midfielder",3)
    createAIPlayer("Blue","Midfielder",4)
    createAIPlayer("Blue","Striker",1)
    createAIPlayer("Blue","Striker",2)
    
    resetPositions("Red")
    createFieldUI()
    
    local onEnd = function()
        task.wait(0.5)
        local winner, sA, sB = finishFieldMatch()
        
        -- Determine winner team
        local winnerName = nil
        if sA > sB then winnerName = redName
        elseif sB > sA then winnerName = blueName end
        
        if callback then
            callback(winnerName, sA, sB, redName, blueName)
        end
    end
    
    startFieldTimer(onEnd)
    
    -- Heartbeat loop for field
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if not tournament.fieldActive then
            if conn then conn:Disconnect() end
            return
        end
        updatePlayerDribble(dt)
        updateAILogic(dt)
        checkRules()
        if tick()-gameState.lastInterceptCheck>0.1 then
            gameState.lastInterceptCheck=tick()
            checkInterception()
        end
    end)
end

