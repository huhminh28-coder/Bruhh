local function simulateMatch(teamA, teamB)
    -- Random simulation based on random score
    local scoreA = math.random(0, 4)
    local scoreB = math.random(0, 4)
    while scoreA == scoreB do
        -- Penalty shootout: pick random
        scoreA = math.random(0, 4)
        scoreB = math.random(0, 4)
    end
    local winner = (scoreA > scoreB) and teamA or teamB
    return winner, scoreA, scoreB
end

