--------------------------------------------------
-- FLASHLIGHT HELPER
--------------------------------------------------
local function toggleAvatarFlashlight(enable)
	flashlightActive = enable
	
	if flashlightInstance then
		flashlightInstance:Destroy()
		flashlightInstance = nil
	end

	if flashlightActive then
		local character = player.Character
		if character then
			local attachPart = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
			if attachPart then
				local light = Instance.new("SpotLight")
				light.Name = "PhoneFlashlight"
				light.Brightness = 5
				light.Range = 60
				light.Angle = 70
				light.Face = Enum.NormalId.Front
				light.Shadows = true
				light.Parent = attachPart
				flashlightInstance = light
			end
		end
	end
end

