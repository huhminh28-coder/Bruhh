end

local function onGoalScored(scoringTeam)
    if gameState.goalScored then return end
    gameState.goalScored=true
    if scoringTeam=="Red" then gameState.scoreRed=gameState.scoreRed+1
    else gameState.scoreBlue=gameState.scoreBlue+1 end
    showGoalText()
    local goalZ=(scoringTeam=="Red") and (MAP_POS.Z+PITCH_LENGTH/2) or (MAP_POS.Z-PITCH_LENGTH/2)
    createFireworks(Vector3.new(MAP_POS.X,MAP_POS.Y+30,goalZ))
    task.wait(3)
    hideGoalText()
    local concedingTeam=(scoringTeam=="Red") and "Blue" or "Red"
    resetPositions(concedingTeam)
    gameState.lastTouchTeam=nil
    gameState.goalScored=false
end

local function resetBallTo(pos)
    local ball=gameState.ball
    if not ball then return end
    ball.CFrame=CFrame.new(pos+Vector3.new(0,5,0))
    ball.AssemblyLinearVelocity=Vector3.new(0,0,0)
    ball.AssemblyAngularVelocity=Vector3.new(0,0,0)
end

local function restart(type,sideX)
    if gameState.restartCooldown then return end
    gameState.restartCooldown=true
    local ball=gameState.ball
    if not ball then gameState.restartCooldown=false; return end
    if type=="ThrowIn" then resetBallTo(Vector3.new(sideX,MAP_POS.Y,ball.Position.Z))
    elseif type=="Corner" then
        local sideZ=(ball.Position.Z>MAP_POS.Z) and (PITCH_LENGTH/2) or (-PITCH_LENGTH/2)
        local sideX2=(ball.Position.X>MAP_POS.X) and (PITCH_WIDTH/2) or (-PITCH_WIDTH/2)
        resetBallTo(MAP_POS+Vector3.new(sideX2,0,sideZ))
    elseif type=="GoalKick" then
        local sideZ=(ball.Position.Z>MAP_POS.Z) and (PITCH_LENGTH/2-30) or (-PITCH_LENGTH/2+30)
        resetBallTo(MAP_POS+Vector3.new(0,0,sideZ))
    end
    task.wait(1)
    gameState.restartCooldown=false
end

local function checkRules()
    local ball=gameState.ball
    if not ball or not ball.Parent or gameState.restartCooldown or not gameState.gameActive or gameState.goalScored then return end
    local bp=ball.Position
    if math.abs(bp.X-MAP_POS.X)>PITCH_WIDTH/2+5 then restart("ThrowIn",bp.X>MAP_POS.X and (PITCH_WIDTH/2-3) or (-PITCH_WIDTH/2+3)); return end
    if math.abs(bp.Z-MAP_POS.Z)>PITCH_LENGTH/2+5 then
        local withinW=math.abs(bp.X-MAP_POS.X)<GOAL_WIDTH/2
        local underBar=(bp.Y-MAP_POS.Y)<(GOAL_HEIGHT+2) and (bp.Y-MAP_POS.Y)>-5
        local isGoal=withinW and underBar
        local isFront=bp.Z<MAP_POS.Z-PITCH_LENGTH/2
        local isBack=bp.Z>MAP_POS.Z+PITCH_LENGTH/2
        if isGoal and (isFront or isBack) then
            if isBack then task.spawn(onGoalScored,"Red") else task.spawn(onGoalScored,"Blue") end
        else
            if gameState.lastTouchTeam=="Red" then restart("GoalKick") else restart("Corner") end
        end
    end
end

local function finishFieldMatch()
    local redName = gameState.redTeamName
    local blueName = gameState.blueTeamName
    local scoreRed = gameState.scoreRed
    local scoreBlue = gameState.scoreBlue
    local winner = (scoreRed > scoreBlue) and redName or (scoreBlue > scoreRed) and blueName or nil
    
    -- Cleanup field
    gameState.gameActive = false
    gameState.paused = true
    gameState.playerDribbling = false
    
    if gameState.ui then gameState.ui:Destroy() gameState.ui=nil end
    local stadium = workspace:FindFirstChild("WC2026Stadium")
    if stadium then stadium:Destroy() end
    if gameState.ball then gameState.ball:Destroy() gameState.ball=nil end
    
    for _,b in ipairs(gameState.redTeam) do b:Destroy() end
    for _,b in ipairs(gameState.blueTeam) do b:Destroy() end
    gameState.redTeam={}
    gameState.blueTeam={}
    
    gameState.matchEndCallback = nil
    tournament.matchInProgress = false
    tournament.fieldActive = false
    
    return winner, scoreRed, scoreBlue
end

