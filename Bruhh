    ball.AssemblyAngularVelocity = Vector3.new(0,0,0)
    gameState.lastTouchTeam = (gameState.playerTeamIndex == 1) and "Red" or "Blue"
    gameState.lastTouchPlayer = nil
end

local function doDribble()
