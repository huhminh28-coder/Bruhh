local function updateGoalkeeperAI(gk, dt)
    local ball = gameState.ball
    if not ball or not gk.PrimaryPart then return end
    local gkId = gk:GetDebugId()
    local team = gk.Team.Value
    local goalLineZ = (team == "Red") and (MAP_POS.Z - PITCH_LENGTH/2 + 12) or (MAP_POS.Z + PITCH_LENGTH/2 - 12)
    local minX = MAP_POS.X - GOAL_WIDTH/2 - 3
    local maxX = MAP_POS.X + GOAL_WIDTH/2 + 3
    local boxMinZ, boxMaxZ
    if team == "Red" then
        boxMinZ = MAP_POS.Z - PITCH_LENGTH/2 - 3
        boxMaxZ = MAP_POS.Z - PITCH_LENGTH/2 + PENALTY_BOX_DEPTH
    else
        boxMinZ = MAP_POS.Z + PITCH_LENGTH/2 - PENALTY_BOX_DEPTH
        boxMaxZ = MAP_POS.Z + PITCH_LENGTH/2 + 3
    end
    local bp = ball.Position
    local bv = ball.AssemblyLinearVelocity
    local bSpeed = bv.Magnitude
    local cdEnd = gameState.gkHoldCooldowns[gkId] or 0
    if tick() < cdEnd then return end
    local predX, predY = bp.X, MAP_POS.Y + 8
    local approaching, timeToGoal = false, 999
    if (team == "Red" and bv.Z < -5) or (team == "Blue" and bv.Z > 5) then
        if math.abs(bv.Z) > 5 then
            timeToGoal = (goalLineZ - bp.Z) / bv.Z
            if timeToGoal > 0 and timeToGoal < 5 then
                approaching = true
                predX = bp.X + bv.X * timeToGoal
                predY = bp.Y + bv.Y * timeToGoal - 0.5 * workspace.Gravity * timeToGoal * timeToGoal
            end
        end
    end
    local tX = math.clamp(predX, minX, maxX)
    local ballInBox = (bp.Z >= boxMinZ and bp.Z <= boxMaxZ and bp.X >= minX and bp.X <= maxX)
    local tZ = goalLineZ
    if ballInBox or approaching then
        if team == "Red" then tZ = math.clamp(bp.Z + 3, boxMinZ, boxMaxZ)
        else tZ = math.clamp(bp.Z - 3, boxMinZ, boxMaxZ) end
    end
    -- Thủ môn linh hoạt: tiến lên khi bóng vào box
    local speed = GK_SPEED
    if approaching then
        if timeToGoal < 0.8 then speed = GK_SPEED * 6.5
        elseif timeToGoal < 1.5 then speed = GK_SPEED * 4.5
        elseif timeToGoal < 3 then speed = GK_SPEED * 2.5 end
    end
    local jumpHeight = 0
    if approaching then
        if predY > MAP_POS.Y + 22 then jumpHeight = 3
        elseif predY > MAP_POS.Y + 15 then jumpHeight = 2
        elseif predY > MAP_POS.Y + 8 then jumpHeight = 1 end
    end
    local tY = TORSO_Y + jumpHeight
    local gkPos = gk.PrimaryPart.Position
    local targetPos = Vector3.new(tX, tY, tZ)
    local dir = targetPos - gkPos
    local dTB = (gkPos - bp).Magnitude
    if dTB > 4 and dir.Magnitude > 0.3 then
        local newPos = gkPos + dir.Unit * speed * dt
        newPos = Vector3.new(
            math.clamp(newPos.X, minX, maxX),
            TORSO_Y + jumpHeight,
            math.clamp(newPos.Z, boxMinZ, boxMaxZ)
        )
        moveCharacter(gk, newPos, Vector3.new(bp.X, newPos.Y, bp.Z))
    end
    -- BẮT BÓNG
    if dTB < 7 and tick() >= cdEnd then
        -- Phân loại: bóng cao (Y > 12) → đẩy ra, bóng thấp → chụp lại
        local ballHeight = bp.Y - MAP_POS.Y
        local isHighShot = ballHeight > 12
        local isKnuckle = gameState.ballIsCurving
        
        if isHighShot or isKnuckle then
            -- BÓNG CAO / KNUCKLE → ĐẨY RA
            local parryDir = Vector3.new(bp.X - gkPos.X, 0, bp.Z - gkPos.Z)
            if parryDir.Magnitude < 1 then parryDir = Vector3.new(0, 0, 1) end
            parryDir = parryDir.Unit
            ball.AssemblyLinearVelocity = parryDir * 120 + Vector3.new(0, 100, 0)
            ball.AssemblyAngularVelocity = Vector3.new(math.random(-30,30), math.random(-30,30), math.random(-30,30))
            playBallKick(ball.Position, math.random(70,85)/100)
            -- Particle effect
            local fx = Instance.new("Part")
            fx.Anchored = true; fx.CanCollide = false; fx.Transparency = 1
            fx.Size = Vector3.new(0.5,0.5,0.5); fx.Position = ball.Position; fx.Parent = workspace
            local e = Instance.new("ParticleEmitter", fx)
            e.Texture = "rbxassetid://296874871"
            e.Color = ColorSequence.new(Color3.fromRGB(255,255,200))
            e.LightEmission = 1; e.Lifetime = NumberRange.new(0.3,0.7)
            e.Speed = NumberRange.new(30,60); e.SpreadAngle = Vector2.new(180,180)
            e.Size = NumberSequence.new(1.5); e.Transparency = NumberSequence.new(1)
            e.Acceleration = Vector3.new(0,-50,0); e:Emit(30)
            task.delay(1, function() if fx then fx:Destroy() end end)
            gameState.ballIsCurving = false
            gameState.lastTouchTeam = team
            gameState.lastTouchPlayer = gk
            gameState.gkHoldCooldowns[gkId] = tick() + 0.8
        else
            -- BÓNG THẤP → CHỤP LẠI + chuyền
            ball.AssemblyLinearVelocity = Vector3.new(0,0,0)
            ball.AssemblyAngularVelocity = Vector3.new(0,0,0)
            gameState.ballIsCurving = false
            gameState.lastTouchTeam = team
            gameState.lastTouchPlayer = gk
            playBallTouchSound()
            gameState.gkHolding = true
            gameState.gkHoldCooldowns[gkId] = tick() + 3.0
            task.spawn(function()
                task.wait(2.0)
                if not ball or not ball.Parent then gameState.gkHolding = false; return end
                -- Tìm đồng đội gần nhất
                local teammates = {}
                for _, t in ipairs(gameState.teams) do
                    if t.team == team and t.model ~= gk then table.insert(teammates, t.model) end
                end
                local nearest, md = nil, math.huge
                for _, tm in ipairs(teammates) do
                    if tm.PrimaryPart then
                        local d = (tm.PrimaryPart.Position - ball.Position).Magnitude
                        if d < md then md = d; nearest = tm end
                    end
                end
                if nearest then
                    -- 40% chuyền bổng, 60% chuyền sệt
                    if math.random() < 0.4 or md > 200 then
                        -- Chuyền bổng dài
                        local d = (nearest.PrimaryPart.Position - ball.Position).Unit
                        local power = math.clamp(md * 0.9, 100, 200)
                        ball.AssemblyLinearVelocity = d * power + Vector3.new(0, md * 0.4 + 40, 0)
                    else
                        -- Chuyền sệt
                        local d = (nearest.PrimaryPart.Position - ball.Position).Unit
                        ball.AssemblyLinearVelocity = d * math.clamp(md * 1.2, 120, 250) + Vector3.new(0, 30, 0)
                    end
                    gameState.previousTouchPlayer = gameState.lastTouchPlayer
                    gameState.lastTouchPlayer = gk
                else
                    local attackDir = (team == "Red") and 1 or -1
                    ball.AssemblyLinearVelocity = Vector3.new(0, 100, attackDir * 150)
                end
                gameState.gkHolding = false
            end)
        end
    end
end

