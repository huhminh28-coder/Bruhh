local function startTimer()
    task.spawn(function()
        while true do
            task.wait(1)
            if gameState.gameActive and not gameState.paused and not gameState.gkHolding and not gameState.goalScored then
                gameState.timeLeft = gameState.timeLeft - 1
                if gameState.timeLeft <= 0 then
                    if gameState.isExtraTime then
                        showBigText("EXTRA TIME ENDED\nDRAW!", Color3.fromRGB(255,200,100))
                        task.wait(3); hideBigText()
                        showMatchSummary()
                        gameState.restartCountdown = FULL_BREAK
                        while gameState.restartCountdown > 0 do
                            task.wait(1); gameState.restartCountdown = gameState.restartCountdown - 1
                        end
                        if gameState.ui.summaryFrame then gameState.ui.summaryFrame.Visible = false end
                        gameState.currentHalf = 1; gameState.timeLeft = HALF_TIME
                        gameState.score = {0,0}; gameState.goals = {}
                        gameState.isExtraTime = false; gameState.goalScored = false
                        gameState.gkHoldCooldowns = {}; gameState.passCooldowns = {}
                        gameState.playerDribbling = false; gameState.aiDribbleState = {}
                        gameState.paused = false; initTeams()
                        local homeColor = gameState.homeTeam.c
                        local awayColor = gameState.awayTeam.c
                        for _, t in ipairs(gameState.teams) do
                            local clr = (t.team == "Red") and homeColor or awayColor
                            for _, part in ipairs(t.model:GetChildren()) do
                                if part:IsA("BasePart") and (part.Name == "Torso" or part.Name:find("Arm")) then
                                    part.Color = clr
                                end
                            end
                        end
                        updatePlayerAppearance()
                        resetPositions("Red")
                        gameState.gameActive = true
                    elseif gameState.currentHalf < gameState.maxHalves then
                        gameState.paused = true; gameState.gameActive = false
                        showBigText("HALF TIME", Color3.fromRGB(255,255,100))
                        task.wait(3); hideBigText()
                        gameState.restartCountdown = HALF_BREAK
                        while gameState.restartCountdown > 0 do
                            task.wait(1); gameState.restartCountdown = gameState.restartCountdown - 1
                        end
                        gameState.currentHalf = gameState.currentHalf + 1
                        gameState.timeLeft = HALF_TIME
                        gameState.playerDribbling = false
                        resetPositions("Red")
                        gameState.paused = false; gameState.gameActive = true
                    else
                        gameState.paused = true; gameState.gameActive = false
                        if gameState.score[1] == gameState.score[2] then
                            showBigText("FULL TIME\nDRAW!\nEXTRA TIME", Color3.fromRGB(255,255,100))
                            task.wait(3); hideBigText()
                            gameState.restartCountdown = HALF_BREAK
                            while gameState.restartCountdown > 0 do
                                task.wait(1); gameState.restartCountdown = gameState.restartCountdown - 1
                            end
                            gameState.isExtraTime = true
                            gameState.timeLeft = EXTRA_TIME
                            gameState.playerDribbling = false
                            resetPositions("Red")
                            gameState.paused = false; gameState.gameActive = true
                        else
                            local w = (gameState.score[1] > gameState.score[2]) and (gameState.homeTeam.full .. " WINS!") or (gameState.awayTeam.full .. " WINS!")
                            task.spawn(function() endMatch("FULL TIME\n" .. w) end)
                        end
                    end
                end
            end
        end
    end)
end

