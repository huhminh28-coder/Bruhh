-- STARTUP
-- ============================================================
local function autoStart()
    local char = player.Character or player.CharacterAdded:Wait()
    gameState.playerChar = char
    player.CharacterAdded:Connect(function(nc)
        gameState.playerChar = nc
        gameState.sprinting = false
        gameState.playerDribbling = false
        task.wait(0.5)
        updatePlayerAppearance()
    end)
    
    setupFieldLighting()
    createStadium()
    createBall()
    
    -- Show team selection
    showTeamSelection(function(selectedTeam)
        print("=== You selected: " .. selectedTeam.name .. " ===")
        task.wait(1)
        runTournament()
    end)
    
    -- Main game loop
    RunService.Heartbeat:Connect(function(dt)
        if gameState.gameActive and not gameState.isPenaltyShootout then
            updatePlayerDribble(dt)
            updateAILogic(dt)
            checkRules()
            if tick() - gameState.lastInterceptCheck > 0.1 then
                gameState.lastInterceptCheck = tick()
                checkInterception()
            end
        end
    end)
    
    print("=== WORLD CUP 2026 TOURNAMENT ===")
    print("32 teams | Home & Away kits | Penalty shootout")
end

autoStart()
