    gameState.bigTextLabel.Text=text
    gameState.bigTextLabel.TextColor3=color or Color3.fromRGB(255,255,255)
    gameState.bigTextLabel.Visible=true
end
local function hideBigText()
    if not gameState.bigTextLabel then return end
