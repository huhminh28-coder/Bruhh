-- BRACKET & TOURNAMENT LOGIC
-- ============================================================
local function shuffleTable(t)
    for i = #t, 2, -1 do
        local j = math.random(i)
        t[i], t[j] = t[j], t[i]
    end
end

local function generateBracket()
    -- Shuffle all teams except player's team
    local others = {}
    for _,team in ipairs(TEAMS) do
        if team ~= tournament.playerTeam then
            table.insert(others, team)
        end
    end
    shuffleTable(others)
    
    -- Build Round of 32 matches (16 matches = 32 teams)
    tournament.rounds.R32 = {}
    -- Player's match first
    table.insert(tournament.rounds.R32, {team1 = tournament.playerTeam, team2 = others[1]})
    -- Other 15 matches
    for i = 2, 31, 2 do
        table.insert(tournament.rounds.R32, {team1 = others[i], team2 = others[i+1]})
    end
end

local function simulateMatch(team1, team2)
    -- Simulate random result for non-player matches
    local score1 = math.random(0, 4)
    local score2 = math.random(0, 4)
    if score1 == score2 then
        -- Penalty chance
        if math.random() < 0.5 then
            score1 = score1 + 1
        else
            score2 = score2 + 1
        end
    end
    if score1 > score2 then return team1, score1, score2
    else return team2, score1, score2 end
end

local function advanceTournament()
    local currentRoundMatches = tournament.rounds[tournament.currentRound]
    local nextRound = nil
    if tournament.currentRound == "R32" then nextRound = "R16"
    elseif tournament.currentRound == "R16" then nextRound = "QF"
    elseif tournament.currentRound == "QF" then nextRound = "SF"
    elseif tournament.currentRound == "SF" then nextRound = "F"
    end
    
    if not nextRound then
        -- Tournament complete
        return nil
    end
    
    tournament.rounds[nextRound] = {}
    
    -- Process each match in current round
    local winners = {}
    for _,match in ipairs(currentRoundMatches) do
        if match.team1 == tournament.playerTeam or match.team2 == tournament.playerTeam then
            -- Player match - winner already determined
            table.insert(winners, match.winner)
        else
            -- Simulate
            local winner = simulateMatch(match.team1, match.team2)
            table.insert(winners, winner)
        end
    end
    
    -- Pair winners into next round matches
    for i = 1, #winners, 2 do
        table.insert(tournament.rounds[nextRound], {team1 = winners[i], team2 = winners[i+1]})
    end
    
    tournament.currentRound = nextRound
    return nextRound
end

