local function createAIPlayer(team, role, idx, teamColor, pname)
    local bot = Instance.new("Model")
    bot.Name = team .. "_" .. role .. "_" .. idx
    local skinColor = Color3.fromRGB(255,215,170)
    local function mp(name, size, color, ox, oy, oz)
