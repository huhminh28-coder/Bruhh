local function shuffleTeams()
    local copy = {}
    for _,t in ipairs(TEAMS) do table.insert(copy, t) end
    for i = #copy, 2, -1 do
        local j = math.random(i)
        copy[i], copy[j] = copy[j], copy[i]
    end
    return copy
end

local function buildRound(roundName)
    local size = getRoundSize(roundName)
    local teams
    if roundName == "Round of 32" then
        teams = shuffleTeams()
    else
        teams = tournament.aliveTeams
    end
    
    tournament.rounds[roundName] = {}
    for i = 1, size, 2 do
        if teams[i] and teams[i+1] then
            table.insert(tournament.rounds[roundName], {
                teamA = teams[i],
                teamB = teams[i+1],
                winner = nil,
                scoreA = 0,
                scoreB = 0
            })
        end
    end
end

