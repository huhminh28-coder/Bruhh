local function playPlayerMatch(opponent, onComplete)
    local playerIsHome = math.random() < 0.5
    setupMatch(tournament.playerTeam, opponent, playerIsHome)
    createGameUI()
    startTimer()
    
    gameState.isPenaltyShootout = false
    
    matchCallback = function(scoreRed, scoreBlue, playerWon)
        -- Determine result
        local playerScore, opponentScore
        if playerIsHome then
            playerScore = scoreRed; opponentScore = scoreBlue
        else
            playerScore = scoreBlue; opponentScore = scoreRed
        end
        
        -- Player wins if they scored more, or won penalties
        local playerWins
        if playerScore > opponentScore then playerWins = true
        elseif opponentScore > playerScore then playerWins = false
        else playerWins = playerWon end
        
        task.wait(2)
        if gameState.ui then gameState.ui:Destroy() end
        if matchCallback then matchCallback = nil end
        
        onComplete(playerWins, playerScore, opponentScore)
    end
end

local function runTournament()
    tournament.tournamentActive = true
    tournament.currentRound = "R32"
    generateBracket()
    
    local function processRound()
        local matches = tournament.rounds[tournament.currentRound]
        if not matches then
            print("Tournament complete!")
            return
        end
        
        -- Find player match
        local playerMatchIdx = nil
        for i, m in ipairs(matches) do
            if m.team1 == tournament.playerTeam or m.team2 == tournament.playerTeam then
                playerMatchIdx = i
                break
            end
        end
        
        if not playerMatchIdx then
            print("Player eliminated!")
            return
        end
        
        local playerMatch = matches[playerMatchIdx]
        local opponent = (playerMatch.team1 == tournament.playerTeam) and playerMatch.team2 or playerMatch.team1
        
        print("=== " .. tournament.currentRound .. ": " .. tournament.playerTeam.code .. " vs " .. opponent.code .. " ===")
        
        -- Show bracket before match
        showBracketDisplay()
        task.wait(3)
        
        playPlayerMatch(opponent, function(playerWins, ps, os)
            playerMatch.winner = playerWins and tournament.playerTeam or opponent
            playerMatch.score1 = ps
            playerMatch.score2 = os
            
            -- Simulate other matches
            for i, m in ipairs(matches) do
                if i ~= playerMatchIdx then
                    local winner, s1, s2 = simulateMatch(m.team1, m.team2)
                    m.winner = winner
                    m.score1 = s1
                    m.score2 = s2
                end
            end
            
            if not playerWins then
                showBigText("ELIMINATED!\n" .. opponent.name .. " advances", Color3.fromRGB(255, 100, 100))
                task.wait(4)
                hideBigText()
                print("=== TOURNAMENT OVER: You were eliminated in " .. tournament.currentRound .. " ===")
                tournament.tournamentActive = false
                return
            end
            
            -- Advance
            local nextRound = advanceTournament()
            if not nextRound then
                showBigText("🏆 WORLD CUP CHAMPION! 🏆\n" .. tournament.playerTeam.name, Color3.fromRGB(255, 215, 0))
                task.wait(5)
                hideBigText()
                print("=== 🏆 " .. tournament.playerTeam.name .. " ARE WORLD CUP CHAMPIONS! ===")
                tournament.tournamentActive = false
                return
            end
            
            showBigText(tournament.playerTeam.name .. " ADVANCES!\nNext: " .. nextRound, Color3.fromRGB(100, 255, 100))
            task.wait(3)
            hideBigText()
            
            -- Continue to next round
            task.wait(2)
            processRound()
        end)
    end
    
    processRound()
end

