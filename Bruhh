local function autoStart()
    local char = player.Character or player.CharacterAdded:Wait()
    gameState.playerChar = char
    player.CharacterAdded:Connect(function(nc)
        gameState.playerChar = nc
        gameState.sprinting = false
        gameState.playerDribbling = false
        task.wait(0.5)
        updatePlayerAppearance()
    end)
    createStadium()
    createBall()
    
    local homeColor = gameState.homeTeam.c
    local awayColor = gameState.awayTeam.c
    
    -- Tạo 11 cầu thủ mỗi đội
    createAIPlayer("Red", "Goalkeeper", 1, homeColor)
    createAIPlayer("Red", "Defender", 1, homeColor)
    createAIPlayer("Red", "Defender", 2, homeColor)
    createAIPlayer("Red", "Defender", 3, homeColor)
    createAIPlayer("Red", "Defender", 4, homeColor)
    createAIPlayer("Red", "Midfielder", 1, homeColor)
    createAIPlayer("Red", "Midfielder", 2, homeColor)
    createAIPlayer("Red", "Midfielder", 3, homeColor)
    createAIPlayer("Red", "Midfielder", 4, homeColor)
    createAIPlayer("Red", "Striker", 1, homeColor)
    createAIPlayer("Red", "Striker", 2, homeColor)
    
    createAIPlayer("Blue", "Goalkeeper", 1, awayColor)
    createAIPlayer("Blue", "Defender", 1, awayColor)
    createAIPlayer("Blue", "Defender", 2, awayColor)
    createAIPlayer("Blue", "Defender", 3, awayColor)
    createAIPlayer("Blue", "Defender", 4, awayColor)
    createAIPlayer("Blue", "Midfielder", 1, awayColor)
    createAIPlayer("Blue", "Midfielder", 2, awayColor)
    createAIPlayer("Blue", "Midfielder", 3, awayColor)
    createAIPlayer("Blue", "Midfielder", 4, awayColor)
    createAIPlayer("Blue", "Striker", 1, awayColor)
    createAIPlayer("Blue", "Striker", 2, awayColor)
    
    resetPositions("Red")
    gameState.gameActive = true
    createGameUI()
    startTimer()
    RunService.Heartbeat:Connect(function(dt)
        updatePlayerDribble(dt)
        updateAILogic(dt)
        checkRules()
        if tick() - (gameState.lastInterceptCheck or 0) > 0.1 then
            gameState.lastInterceptCheck = tick()
            checkInterception()
        end
    end)
    print("=== WORLD CUP 2026 ===")
    print("Clubs: " .. gameState.homeTeam.full .. " vs " .. gameState.awayTeam.full)
end

autoStart()
