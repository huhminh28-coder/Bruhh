-- ==========================================
-- TOURNAMENT MAIN LOOP
-- ==========================================
local function runRound()
    local roundName = tournament.currentRound
    local matches = tournament.rounds[roundName]
    
    if not matches or #matches == 0 then return end
    
    -- Find player's match
    local playerMatchIdx = nil
    for i, m in ipairs(matches) do
        if m.teamA == tournament.playerTeam or m.teamB == tournament.playerTeam then
            playerMatchIdx = i
            break
        end
    end
    
    -- Simulate all AI matches first
    for i, m in ipairs(matches) do
        if i ~= playerMatchIdx then
            local winner, sA, sB = simulateMatch(m.teamA, m.teamB)
            m.winner = winner
            m.scoreA = sA
            m.scoreB = sB
            print(string.format("[%s] %s %d - %d %s → %s", roundName, m.teamA, sA, sB, m.teamB, winner))
        end
    end
    
    -- If player is out, just show results and advance
    local playerAlive = false
    for _, m in ipairs(matches) do
        if (m.teamA == tournament.playerTeam or m.teamB == tournament.playerTeam) then
            playerAlive = true
            break
        end
    end
    
    -- Collect winners
    local winners = {}
    for _, m in ipairs(matches) do
        if m.winner then table.insert(winners, m.winner) end
    end
    tournament.aliveTeams = winners
    
    -- Show bracket
    showBracketUI(function()
        if playerMatchIdx then
            -- Player has a match to play
            local pm = matches[playerMatchIdx]
            local opponent = (pm.teamA == tournament.playerTeam) and pm.teamB or pm.teamA
            
            print(string.format("⚽ YOUR MATCH: %s vs %s", tournament.playerTeam, opponent))
            
            startFieldMatch(tournament.playerTeam, opponent, tournament.playerTeam, function(winner, sPlayer, sOpp, redName, blueName)
                -- Update the match result
                pm.winner = winner
                if pm.teamA == tournament.playerTeam then
                    pm.scoreA = sPlayer; pm.scoreB = sOpp
                else
                    pm.scoreA = sOpp; pm.scoreB = sPlayer
                end
                print(string.format("[%s] %s %d - %d %s → %s", roundName, pm.teamA, pm.scoreA, pm.scoreB, pm.teamB, winner))
                
                -- Update alive teams
                local newAlive = {}
                for _, m in ipairs(matches) do
                    if m.winner then table.insert(newAlive, m.winner) end
                end
                tournament.aliveTeams = newAlive
                
                -- Check if player still alive
                local stillIn = false
                for _, t in ipairs(tournament.aliveTeams) do
                    if t == tournament.playerTeam then stillIn = true break end
                end
                
                -- Advance to next round
                local nextRound = getNextRound(roundName)
                if nextRound then
                    tournament.currentRound = nextRound
                    task.wait(1)
                    buildRound(nextRound)
                    task.wait(0.5)
                    runRound()
                else
                    -- Tournament complete
                    local champion = tournament.aliveTeams[1]
                    local msg = "🏆 CHAMPION: " .. (champion or "???") .. " 🏆"
                    if champion == tournament.playerTeam then
                        msg = "🏆 YOU WON THE WORLD CUP! 🏆"
                    end
                    print(msg)
                    
                    local gui = Instance.new("ScreenGui")
                    gui.Name = "ChampionGUI"
                    gui.Parent = player.PlayerGui
                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    lbl.BackgroundTransparency = 0.3
                    lbl.Text = msg
                    lbl.TextColor3 = Color3.fromRGB(255, 215, 0)
                    lbl.TextScaled = true
                    lbl.Font = Enum.Font.FredokaOne
                    lbl.Parent = gui
                end
            end)
        else
            -- Player eliminated, continue simulating silently
            local nextRound = getNextRound(roundName)
            if nextRound then
                tournament.currentRound = nextRound
                task.wait(0.5)
                buildRound(nextRound)
                task.wait(0.5)
                runRound()
            end
        end
    end)
end

