local function onGoalScored(scoringTeam, isOwnGoal)
    if gameState.goalScored then return end
    gameState.goalScored = true
    local scorer, assist = nil, nil
    local scorerModel = gameState.lastTouchPlayer
    local assistModel = gameState.previousTouchPlayer
    
    -- Determine final scoring team (own goal reverses)
    local actualScoringTeam = scoringTeam
    if isOwnGoal then
        actualScoringTeam = (scoringTeam == "Red") and "Blue" or "Red"
    end
    
    -- Determine scorer name and team
    if scorerModel and scorerModel:FindFirstChild("PlayerName") then
        scorer = scorerModel.PlayerName.Value
    elseif scorerModel == nil and gameState.playerDribbling then
        scorer = player.DisplayName
    end
    
    if assistModel and assistModel:FindFirstChild("PlayerName") and assistModel ~= scorerModel then
        assist = assistModel.PlayerName.Value
    end
    
    -- If own goal, scorer is the player from the conceding team
    if isOwnGoal then
        if scorerModel and scorerModel:FindFirstChild("PlayerName") then
            scorer = scorerModel.PlayerName.Value
        end
        assist = nil
    end
    
    -- Update score
    local idx = (actualScoringTeam == "Red") and 1 or 2
    gameState.score[idx] = gameState.score[idx] + 1
    
    -- Record goal
    local minute = math.floor(((gameState.currentHalf - 1) * HALF_TIME + (HALF_TIME - gameState.timeLeft)) / 60) + 1
    table.insert(gameState.goals, {
        scorer = scorer or "Unknown",
        assist = assist,
        team = scoringTeam,  -- team that scored (own goal belongs to actual scorer's team)
        time = minute,
        isOwnGoal = isOwnGoal or false
    })
    
    -- Show goal text
    if isOwnGoal then
        showGoalText("OWN GOAL!", Color3.fromRGB(255, 80, 80))
    else
        showGoalText("GOAL!", Color3.fromRGB(255, 255, 0))
    end
    -- Show scorer/assist below board
    local scorerDisplay = scorer or "Unknown"
    if isOwnGoal then
        scorerDisplay = scorerDisplay .. " (OG)"
    end
    local assistDisplay = (assist and not isOwnGoal) and ("  |  Assist: " .. assist) or ""
    if gameState.ui.goalInfo then
        gameState.ui.goalInfo.Text = string.format("⚽ %s %d'%s", scorerDisplay, minute, assistDisplay)
        gameState.ui.goalInfo.Visible = true
        task.delay(5, function() if gameState.ui.goalInfo then gameState.ui.goalInfo.Visible = false end end)
    end
    
    -- Fireworks at correct goal
    local goalZ
    if isOwnGoal then
        goalZ = (scoringTeam == "Red") and (MAP_POS.Z - PITCH_LENGTH/2) or (MAP_POS.Z + PITCH_LENGTH/2)
    else
        goalZ = (scoringTeam == "Red") and (MAP_POS.Z + PITCH_LENGTH/2) or (MAP_POS.Z - PITCH_LENGTH/2)
    end
    createFireworks(Vector3.new(MAP_POS.X, MAP_POS.Y + 30, goalZ))
    
    if gameState.isExtraTime then
        local winnerName = (actualScoringTeam == "Red") and "RED WINS!" or "BLUE WINS!"
        gameState.extraTimeWinner = actualScoringTeam
        task.wait(3)
        hideGoalText()
        endMatch("GOLDEN GOAL!\n" .. winnerName)
        return
    end
    task.wait(3)
    hideGoalText()
    resetPositions(actualScoringTeam == "Red" and "Blue" or "Red")
    gameState.goalScored = false
end

local function checkRules()
    local ball = gameState.ball
    if not ball or not ball.Parent or gameState.restartCooldown or not gameState.gameActive or gameState.goalScored then return end
    local bp = ball.Position
    -- Out of bounds X
    if math.abs(bp.X - MAP_POS.X) > PITCH_WIDTH/2 + 5 then
        local side = bp.X > MAP_POS.X and (PITCH_WIDTH/2 - 3) or (-PITCH_WIDTH/2 + 3)
        gameState.restartCooldown = true
        ball.CFrame = CFrame.new(Vector3.new(side, MAP_POS.Y, bp.Z) + Vector3.new(0,5,0))
        ball.AssemblyLinearVelocity = Vector3.new(0,0,0); ball.AssemblyAngularVelocity = Vector3.new(0,0,0)
        task.wait(1); gameState.restartCooldown = false
        return
    end
    -- Out of bounds Z
    if math.abs(bp.Z - MAP_POS.Z) > PITCH_LENGTH/2 + 5 then
        local withinW = math.abs(bp.X - MAP_POS.X) < GOAL_WIDTH/2
        local underBar = (bp.Y - MAP_POS.Y) < (GOAL_HEIGHT + 2) and (bp.Y - MAP_POS.Y) > -5
        local isGoal = withinW and underBar
        local isFront = bp.Z < MAP_POS.Z - PITCH_LENGTH/2
        local isBack = bp.Z > MAP_POS.Z + PITCH_LENGTH/2
        if isGoal and (isFront or isBack) then
            -- Determine which goal is which
            -- Front goal (Z negative) belongs to Red team
            -- Back goal (Z positive) belongs to Blue team
            local goalTeam = isBack and "Red" or "Blue"  -- The team that the goal belongs to (defending team)
            local actualScoringTeam = isBack and "Red" or "Blue"  -- Team scoring
            -- Check own goal: if lastTouchPlayer belongs to the defending team
            local isOwnGoal = false
            if gameState.lastTouchPlayer then
                local lastTouchTeam = gameState.lastTouchPlayer.Team.Value
                local defendingTeam = isBack and "Blue" or "Red"  -- team that defends that goal
                -- If ball went into defending team's own goal, but lastTouch was by defending team → own goal
                -- Wait, we need to track which team's goal is at which Z
                -- Red attacks towards +Z, so Red's goal (to defend) is at -Z
                -- Blue attacks towards -Z, so Blue's goal is at +Z
                local defendingTeamName = isFront and "Red" or "Blue"
                -- Ball entered defending team's goal
                if lastTouchTeam == defendingTeamName then
                    isOwnGoal = true
                end
            end
            task.spawn(onGoalScored, isBack and "Red" or "Blue", isOwnGoal)
        else
            gameState.restartCooldown = true
            local sideZ = (bp.Z > MAP_POS.Z) and (PITCH_LENGTH/2 - 30) or (-PITCH_LENGTH/2 + 30)
            ball.CFrame = CFrame.new(MAP_POS + Vector3.new(0,5,sideZ))
            ball.AssemblyLinearVelocity = Vector3.new(0,0,0); ball.AssemblyAngularVelocity = Vector3.new(0,0,0)
            task.wait(1); gameState.restartCooldown = false
        end
    end
end

