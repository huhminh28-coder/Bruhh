local function clearTeams()
    for _,bot in ipairs(gameState.redTeam) do if bot then bot:Destroy() end end
    for _,bot in ipairs(gameState.blueTeam) do if bot then bot:Destroy() end end
    gameState.redTeam = {}
    gameState.blueTeam = {}
end

local function getTeamKit(team, isHome)
    if isHome then
        return {primary = team.home, trim = team.homeTrim}
    else
        return {primary = team.away, trim = team.awayTrim}
    end
end

local function getGKKit(team)
    return {primary = team.gk, trim = team.gk}
end

local function setupMatch(playerTeam, opponentTeam, playerIsHome)
    clearTeams()
    gameState.scoreRed = 0
    gameState.scoreBlue = 0
    gameState.timeLeft = HALF_TIME
    gameState.currentHalf = 1
    gameState.isExtraTime = false
    gameState.paused = false
    gameState.goalScored = false
    gameState.gkHoldCooldowns = {}
    gameState.passCooldowns = {}
    gameState.aiDribbleState = {}
    gameState.lastTouchTeam = nil
    
    tournament.currentOpponent = opponentTeam
    tournament.playerIsHome = playerIsHome
    
    -- Determine kits
    local playerKit = playerIsHome and "home" or "away"
    local opponentKit = playerIsHome and "away" or "home"
    
    local redKit, blueKit, redGKKit, blueGKKit
    if playerIsHome then
        redKit = getTeamKit(playerTeam, true)      -- Player home
        blueKit = getTeamKit(opponentTeam, false)  -- Opponent away
        redGKKit = getGKKit(playerTeam)
        blueGKKit = getGKKit(opponentTeam)
    else
        redKit = getTeamKit(opponentTeam, true)    -- Opponent home
        blueKit = getTeamKit(playerTeam, false)    -- Player away
        redGKKit = getGKKit(opponentTeam)
        blueGKKit = getGKKit(playerTeam)
    end
    
    -- Red team (Home side of pitch)
    createAIPlayer("Red", "Goalkeeper", 1, redGKKit)
    for i = 1, 4 do createAIPlayer("Red", "Defender", i, redKit) end
    for i = 1, 4 do createAIPlayer("Red", "Midfielder", i, redKit) end
    for i = 1, 2 do createAIPlayer("Red", "Striker", i, redKit) end
    
    -- Blue team (Away side)
    createAIPlayer("Blue", "Goalkeeper", 1, blueGKKit)
    for i = 1, 4 do createAIPlayer("Blue", "Defender", i, blueKit) end
    for i = 1, 4 do createAIPlayer("Blue", "Midfielder", i, blueKit) end
    for i = 1, 2 do createAIPlayer("Blue", "Striker", i, blueKit) end
    
    -- Player is on Red side always
    gameState.playerTeam = "Red"
    
    resetPositions("Red")
    updatePlayerAppearance()
    gameState.gameActive = true
end

