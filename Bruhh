local function startPenaltyShootout(onFinish)
    gameState.isPenaltyShootout = true
    gameState.gameActive = false
    penaltyState.playerScore = 0
    penaltyState.enemyScore = 0
    penaltyState.round = 0
    penaltyState.active = true
    
    setupPenaltyPositions()
    local gui, shootBtn, scoreLabel, instruction = createPenaltyUI()
    
    -- Wait a moment then start
    task.wait(2)
    
    -- Total 5 rounds (or until winner determined)
    local function checkWinner()
        local playerDone = penaltyState.round >= 5
        local enemyDone = penaltyState.round >= 5
        if playerDone and enemyDone then
            if penaltyState.playerScore ~= penaltyState.enemyScore then
                return true
            end
        end
        -- Sudden death
        if penaltyState.round >= 5 and penaltyState.playerScore ~= penaltyState.enemyScore then
            return true
        end
        return false
    end
    
    -- Main penalty loop
    task.spawn(function()
        for round = 1, 5 do
            penaltyState.round = round
            
            -- Player shoots
            if instruction then instruction.Text = "Round " .. round .. ": Click SHOOT!" end
            shootBtn.Enabled = true
            
            -- Wait for player to click
            local clicked = false
            local conn
            conn = shootBtn.MouseButton1Click:Connect(function()
                clicked = true
                if conn then conn:Disconnect() end
            end)
            
            while not clicked do task.wait(0.1) end
            playerTakePenalty(shootBtn)
            
            task.wait(0.5)
            
            -- AI shoots
            aiTakePenalty()
            
            task.wait(0.5)
            
            -- Early termination check
            local remainingPlayer = 5 - round
            local remainingEnemy = 5 - round
            if penaltyState.playerScore > penaltyState.enemyScore + remainingEnemy then
                break
            end
            if penaltyState.enemyScore > penaltyState.playerScore + remainingPlayer then
                break
            end
        end
        
        -- Sudden death if tied
        local sdRound = 0
        while penaltyState.playerScore == penaltyState.enemyScore do
            sdRound = sdRound + 1
            if instruction then instruction.Text = "SUDDEN DEATH Round " .. sdRound .. "!" end
            
            -- Player
            shootBtn.Enabled = true
            local clicked = false
            local conn
            conn = shootBtn.MouseButton1Click:Connect(function()
                clicked = true
                if conn then conn:Disconnect() end
            end)
            while not clicked do task.wait(0.1) end
            playerTakePenalty(shootBtn)
            task.wait(0.5)
            
            -- AI
            aiTakePenalty()
            task.wait(0.5)
        end
        
        -- Winner decided
        penaltyState.active = false
        if instruction then 
            if penaltyState.playerScore > penaltyState.enemyScore then
                instruction.Text = "YOU WIN THE SHOOTOUT!"
            else
                instruction.Text = "CPU WINS THE SHOOTOUT!"
            end
        end
        shootBtn.Enabled = false
        
        task.wait(3)
        gui:Destroy()
        penaltyUI = nil
        
        onFinish(penaltyState.playerScore > penaltyState.enemyScore)
    end)
end

